{
  "name": "saltman",
  "version": "0.0.1",
  "description": "GitHub Action to analyze PR content and post comments",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:native": "tsgo",
    "package": "bun run build && bun pack",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "tsgo --noEmit",
    "format": "oxfmt --check src",
    "format:fix": "oxfmt src"
  },
  "author": "adriangohjw",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^6.0.1",
    "@ai-sdk/openai-compatible": "^2.0.27",
    "@anthropic-ai/sdk": "^0.73.0",
    "ai": "^6.0.62",
    "minimatch": "^10.1.1",
    "openai": "^6.17.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260205.1",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.42.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.5"
}
